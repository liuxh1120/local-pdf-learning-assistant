# DeepSeek API（必填；未配置时仍可索引 PDF，但不能生成答案）
# DeepSeek API (required for answers; PDF indexing still works without it)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地数据与模型 / Local data and models
DATA_DIR=./data
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=4
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# PDF 分块 / PDF chunking
CHUNK_SIZE=850
CHUNK_OVERLAP=100
MAX_PDF_MB=200
MAX_PDF_PAGES=3000
# 对扫描页运行本地 Tesseract OCR；公式、表格仍会独立结构化提取
# Run local Tesseract OCR on scanned pages; formulas and tables are extracted separately
ENABLE_PAGE_OCR=true

# 联网搜索（可选）/ Web search (optional)
SEARXNG_URL=http://127.0.0.1:8080

# Agent / MCP 工具 / Agent and MCP tools
ENABLE_MCP_TOOLS=true
MCP_MAX_TOOL_ROUNDS=4
# 文件 MCP 只能访问此目录；留空时仅允许访问 data/uploads
# File tools are restricted to this directory; blank defaults to data/uploads
LEARNING_FILES_ROOT=

# Zotero：优先读取本机 Zotero（需打开 Zotero 并启用本地 API）
# Zotero: local API is preferred when Zotero is running and its local API is enabled
ZOTERO_LOCAL_URL=http://127.0.0.1:23119/api
# 仅使用 Zotero 云端库时填写下面两项；本机模式无需填写
# Fill these only for Zotero Web API access; local mode needs neither value
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# Anki：需要打开 Anki 并安装 AnkiConnect
# Anki: requires a running Anki instance with AnkiConnect installed
ANKI_CONNECT_URL=http://127.0.0.1:8765

# OpenAlex 建议填写联系邮箱，以进入 polite pool
# OpenAlex recommends a contact email for its polite pool
ACADEMIC_EMAIL=

# Web 界面 / Web UI
APP_HOST=127.0.0.1
APP_PORT=7860
